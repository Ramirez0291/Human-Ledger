# 人类账本 — 可选配置
# 不建 .env 也能直接 docker compose up -d；需要改默认值时复制为 .env 再修改。

# 会话签名密钥。留空时首次启动自动生成并保存在 data/.secret_key
SECRET_KEY=

# 是否开放注册。全家共用保持 true；家人都注册完后可改为 false
ALLOW_REGISTRATION=true

# 通过 HTTPS 访问时改为 true
COOKIE_SECURE=false

# 默认界面语言：zh-CN | ja | en（每个用户可在界面里自行切换）
DEFAULT_LOCALE=zh-CN
TIMEZONE=Asia/Tokyo

# 对外端口
PORT=8000
