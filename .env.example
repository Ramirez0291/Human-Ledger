# 人类账本 — 环境变量示例
# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，不会进版本库。

# ---- 基础 ----
APP_ENV=development          # development | production
DEBUG=true

# ---- 安全 ----
# 生产环境必须设置；开发 / 自用时留空会自动生成一次，存进 <DATA_DIR>/.secret_key 之后沿用。
# 生成方法：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 通过 HTTPS 部署时改为 true
COOKIE_SECURE=false
# 会话有效期（秒），默认 30 天
SESSION_MAX_AGE_SECONDS=2592000

# ---- 数据 ----
# SQLite 文件与上传的截图都放在这里，部署时挂载为卷
# DATA_DIR=./data
# 留空则使用 <DATA_DIR>/ledger.db；将来换 Postgres 时改这一行即可
DATABASE_URL=

# ---- 本地化 ----
DEFAULT_LOCALE=zh-CN         # zh-CN | ja | en
# 新用户默认的地区包（注册页可改）：JP = 日元 / 日本类目，CN = 人民币 / 中国类目 / 微信账单
DEFAULT_REGION=JP
# 没有用户上下文时用的时区；用户的「今天」按其地区包的时区算
TIMEZONE=Asia/Tokyo

# ---- 多用户 ----
# 是否允许新用户自助注册。个人部署建议设为 false，只保留首次初始化的用户
ALLOW_REGISTRATION=true

# ---- 截图识别（M2 接入，当前仅预留）----
# none      不使用
# local     本地 OCR 引擎，数据不出本机
# cloud_llm 云端多模态模型，准确率高，但截图会发送至第三方服务
OCR_PROVIDER=none
OCR_API_KEY=
OCR_API_BASE=
OCR_MODEL=
