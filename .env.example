# Optional. Copy to .env to override defaults.

# Session signing key. Auto-generated into data/.secret_key when empty.
SECRET_KEY=

# Allow sign-up. Set to false once everyone in the family has an account.
ALLOW_REGISTRATION=true

# Set to true when served over HTTPS.
COOKIE_SECURE=false

# Default UI language: zh-CN | ja | en (each user can switch in the app)
DEFAULT_LOCALE=zh-CN
TIMEZONE=Asia/Tokyo

# Host port
PORT=8000
